[Unit]
Description=CarrTech VM Manager storage provisioning
After=incus.service zfs-mount.service
Before=vm-manager.service

[Service]
Type=simple
WorkingDirectory=/opt/carrtech/vm-manager/current
ExecStart=/opt/carrtech/vm-manager/current/.venv/bin/python -m app.storage_broker
Restart=on-failure
RestartSec=3
RuntimeDirectory=vm-manager-storage
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
# Provisioned mounts must reach the host and the application. Mount namespace
# isolation (including implicit namespaces from ProtectSystem/ProtectHome and
# ProtectKernel* options) would hide newly created ZFS mounts from consumers.
PrivateMounts=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
